# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local Flutter SDK/tool state
/.flutter-tool-data/
/.local-flutter/
/ios/Flutter/
/linux/flutter/ephemeral/
/macos/Flutter/ephemeral/

# Local signing material (never commit private keys or credentials)
**/key.properties
**/*.jks
**/*.keystore

# Local build helpers and generated reports
/android/build/reports/
/build*.log
/gradle_stop.cmd
/tool_build_*.cmd

# Isolated release-build caches and local release artifacts
/.gradle-build-cache/
/.gradle-user/
/.pub-build-cache/
/.android-build-user/
/.codex-flutter-test-sdk/
/.codex-tmp/
/.codex-appdata/
/.flutter-gradle-plugin/
/flutter-gradle-plugin-local/
/flutter-sdk-local/
/outputs/
/assets/legacy-tv-artwork/
